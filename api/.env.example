# Copy to api/.env.local. The values below point at the local development database
# (`npm run dev:db -w @pulse/api`). For production, the real connection strings go only in
# Render's environment settings, never in a file in the repo.

# The dashboard routes (role pm_app) and the public tracking route (role pm_ingest)
DATABASE_URL_APP=postgres://pm_app:pm_app_local@127.0.0.1:5433/pulse
DATABASE_URL_INGEST=postgres://pm_ingest:pm_ingest_local@127.0.0.1:5433/pulse

# Sign-in: a long random string (for example `openssl rand -hex 32`)
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Protects POST /internal/retention
CRON_SECRET=dev-only-cron-secret

# Where the dashboard runs, and where this API is reachable from outside
WEB_ORIGIN=http://localhost:3400
API_PUBLIC_URL=http://localhost:4000

# Only for `npm run db:migrate -w @pulse/api`: the table owner's connection string (never used by the server).
# Local development example:
DATABASE_URL_OWNER=postgres://postgres:owner_local@127.0.0.1:5433/pulse
