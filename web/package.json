{
  "name": "@pulse/web",
  "version": "0.1.0",
  "private": true,
  "description": "PulseMetrics dashboard (Next.js)",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "typecheck": "tsc --noEmit",
    "test:e2e": "next build && playwright test",
    "test:e2e:run": "playwright test",
    "test:smoke": "next build && playwright test --grep @smoke",
    "test:smoke:run": "playwright test --grep @smoke",
    "test:regression": "next build && playwright test",
    "test:regression:run": "playwright test",
    "prebuild": "node scripts/build-snippet.mjs",
    "build:snippet": "node scripts/build-snippet.mjs"
  },
  "dependencies": {
    "@pulse/core": "*",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
